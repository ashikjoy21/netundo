# Copy to .env and fill in your own values. NEVER commit .env.

# --- Web app (apps/web) ---
# Base URL of the deployed netundo API worker (workers/api).
NEXT_PUBLIC_API_WORKER_URL=https://your-api-worker.example.workers.dev

# Optional tuning (defaults in brackets): see README "Configuration".
# NEXT_PUBLIC_SITE_URL=https://netundo.com
# NETUNDO_INDEX_MIN_TESTS=5      # noindex + out of sitemap below this
# NETUNDO_FAQ_MIN_TESTS=5        # never name a "fastest provider" below this
# NETUNDO_FAQ_HEDGE_BELOW=30     # "Based on early data from N tests…" below this
# NEXT_PUBLIC_RANK_MIN_TESTS=10  # below this, networks go in "Early data"

# Optional: self-hosted speed-test measurement worker (workers/speedtest).
# Leave UNSET to measure against Cloudflare's global endpoints (most accurate).
# NEXT_PUBLIC_SPEEDTEST_WORKER_URL=https://speed.example.com

# --- Supabase ---
# Project URL is safe to expose. The anon key is also public by design.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# SECRET — never commit. Set on the API worker with:
#   wrangler secret put SUPABASE_SERVICE_KEY
# (kept out of the repo; do not paste the real value here)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- TRAI MySpeed benchmark ingest (scripts/ingest-trai.mjs) ---
# Free API key from https://data.gov.in (Open Government Data platform).
# Used by `pnpm ingest:trai --resource-id <uuid>` to load the official Kerala
# mobile-speed baseline into the trai_benchmarks table (third-party reference,
# never blended into our own aggregates).
DATA_GOV_API_KEY=your-data-gov-in-api-key

# --- API worker secret for outage reports / comments ---
# Long random string; keys the HMACs of IPs and client tokens. Set with:
#   cd workers/api && wrangler secret put IP_HASH_SALT
